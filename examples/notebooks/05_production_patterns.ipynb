    "## Pattern 8: Testing Strategies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ClaudeMock:\n",
    "    \"\"\"Mock Claude client for testing.\"\"\"\n",
    "    \n",
    "    class Messages:\n",
    "        @staticmethod\n",
    "        def create(**kwargs):\n",
    "            \"\"\"Mock create method.\"\"\"\n",
    "            class MockResponse:\n",
    "                class Content:\n",
    "                    def __init__(self):\n",
    "                        self.type = \"text\"\n",
    "                        self.text = \"This is a mock response\"\n",
    "                \n",
    "                class Usage:\n",
    "                    def __init__(self):\n",
    "                        self.input_tokens = 10\n",
    "                        self.output_tokens = 20\n",
    "                        self.total_tokens = 30\n",
    "                \n",
    "                def __init__(self):\n",
    "                    self.id = \"mock_id_123\"\n",
    "                    self.content = [self.Content()]\n",
    "                    self.usage = self.Usage()\n",
    "                    self.stop_reason = \"end_turn\"\n",
    "                    self.model = kwargs.get(\"model\", \"claude-3-5-sonnet-20241022\")\n",
    "            \n",
    "            return MockResponse()\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.messages = self.Messages()\n",
    "\n",
    "# Test with mock\n",
    "def my_claude_function(client, prompt):\n",
    "    \"\"\"Function that uses Claude.\"\"\"\n",
    "    response = client.messages.create(\n",
    "        model=\"claude-3-5-sonnet-20241022\",\n",
    "        max_tokens=100,\n",
    "        messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "    )\n",
    "    return response.content[0].text\n",
    "\n",
    "# Test with mock client (no API calls)\n",
    "mock_client = ClaudeMock()\n",
    "result = my_claude_function(mock_client, \"Test prompt\")\n",
    "\n",
    "print(\"Mock test result:\")\n",
    "print(f\"  Response: {result}\")\n",
    "print(f\"  ✓ Function works without real API calls\")\n",
    "\n",
    "# Example test assertions\n",
    "assert result == \"This is a mock response\", \"Mock response should match\"\n",
    "print(\"  ✓ Test passed!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Pattern 9: Complete Production Client"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ProductionClaudeClient:\n",
    "    \"\"\"Production-ready Claude client with all best practices.\"\"\"\n",
    "    \n",
    "    def __init__(self, api_key=None, enable_logging=True, enable_monitoring=True):\n",
    "        self.client = Anthropic(api_key=api_key)\n",
    "        self.rate_limiter = RateLimiter(requests_per_minute=50)\n",
    "        self.monitor = PerformanceMonitor() if enable_monitoring else None\n",
    "        self.logger = RequestLogger() if enable_logging else None\n",
    "        self.security = SecurityValidator()\n",
    "    \n",
    "    @retry(\n",
    "        stop=stop_after_attempt(3),\n",
    "        wait=wait_exponential(multiplier=1, min=2, max=10),\n",
    "        retry=retry_if_exception_type((RateLimitError, APIConnectionError))\n",
    "    )\n",
    "    def create_message(self, messages, **kwargs):\n",
    "        \"\"\"Create a message with all production safeguards.\"\"\"\n",
    "        \n",
    "        # Rate limiting\n",
    "        self.rate_limiter.acquire()\n",
    "        \n",
    "        # Input validation\n",
    "        for msg in messages:\n",
    "            if isinstance(msg.get('content'), str):\n",
    "                msg['content'] = self.security.sanitize_input(msg['content'])\n",
    "        \n",
    "        # Model selection\n",
    "        if 'model' not in kwargs:\n",
    "            user_prompt = messages[-1]['content'] if messages else \"\"\n",
    "            kwargs['model'] = SmartModelSelector.select_model(user_prompt)\n",
    "        \n",
    "        # Make request\n",
    "        start_time = time.time()\n",
    "        success = False\n",
    "        error = None\n",
    "        \n",
    "        try:\n",
    "            response = self.client.messages.create(\n",
    "                messages=messages,\n",
    "                max_tokens=kwargs.get('max_tokens', 1024),\n",
    "                **{k: v for k, v in kwargs.items() if k != 'max_tokens'}\n",
    "            )\n",
    "            success = True\n",
    "            \n",
    "            # Security check on output\n",
    "            output_text = response.content[0].text\n",
    "            sensitive = self.security.detect_sensitive_data(output_text)\n",
    "            if sensitive:\n",
    "                logger.warning(f\"Sensitive data detected in response: {len(sensitive)} patterns\")\n",
    "            \n",
    "            return response\n",
    "            \n",
    "        except Exception as e:\n",
    "            error = e\n",
    "            raise\n",
    "        \n",
    "        finally:\n",
    "            duration = time.time() - start_time\n",
    "            \n",
    "            # Monitoring\n",
    "            if self.monitor and success:\n",
    "                self.monitor.record_request(\n",
    "                    duration=duration,\n",
    "                    tokens_in=response.usage.input_tokens if success else 0,\n",
    "                    tokens_out=response.usage.output_tokens if success else 0,\n",
    "                    model=kwargs.get('model', 'unknown'),\n",
    "                    success=success,\n",
    "                    error=error\n",
    "                )\n",
    "            \n",
    "            # Logging\n",
    "            if self.logger and success:\n",
    "                self.logger.log_request(\n",
    "                    request_data={\"messages\": messages, **kwargs},\n",
    "                    response_data={\n",
    "                        \"content\": response.content[0].text if success else None,\n",
    "                        \"usage\": {\n",
    "                            \"input\": response.usage.input_tokens if success else 0,\n",
    "                            \"output\": response.usage.output_tokens if success else 0\n",
    "                        }\n",
    "                    },\n",
    "                    metadata={\"duration\": duration, \"success\": success}\n",
    "                )\n",
    "    \n",
    "    def get_stats(self):\n",
    "        \"\"\"Get performance statistics.\"\"\"\n",
    "        if self.monitor:\n",
    "            return self.monitor.get_summary()\n",
    "        return {\"monitoring\": \"disabled\"}\n",
    "\n",
    "# Test production client\n",
    "prod_client = ProductionClaudeClient()\n",
    "\n",
    "response = prod_client.create_message(\n",
    "    messages=[{\"role\": \"user\", \"content\": \"What is the capital of France?\"}]\n",
    ")\n",
    "\n",
    "print(\"Production client response:\")\n",
    "print(response.content[0].text)\n",
    "print(\"\\nClient statistics:\")\n",
    "print(json.dumps(prod_client.get_stats(), indent=2))"
   ]
